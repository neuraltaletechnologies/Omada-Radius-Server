# ==========================================================================
# Wi-Fi Business Backend - environment configuration
# Copy this file to .env  (cp .env.example .env) and fill in real values.
# NEVER commit .env. All secrets below are server-side only.
# ==========================================================================

# --- App ---
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
APP_URL=

# --- Database (Phase 2 - optional for the Omada connectivity milestone) ---
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/wifi_business

# --- Omada Open API (Settings -> Open API -> Application: WiFi Business Backend) ---
# In Docker Compose on a shared network, use the service name, NOT a container IP.
OMADA_BASE_URL=https://omada:8043
OMADA_CLIENT_ID=
OMADA_CLIENT_SECRET=
OMADA_ID=
OMADA_SITE_ID=
OMADA_MODE=real
# Omada uses self-signed TLS; keep verification on only if you installed a trusted cert.
OMADA_TLS_REJECT_UNAUTHORIZED=false
OMADA_HTTP_TIMEOUT_MS=15000
OMADA_TOKEN_TTL_SAFETY_S=60

# --- Payment provider (later milestone) ---
PAYMENT_PROVIDER=none
PAYMENT_API_URL=
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
PAYMENT_CALLBACK_URL=

# --- SMS provider (later milestone) ---
SMS_PROVIDER=none
SMS_API_URL=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=

# --- Admin access (shared secret for now; RBAC later) ---
ADMIN_API_KEY=